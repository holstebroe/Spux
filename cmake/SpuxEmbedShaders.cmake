# Embeds the GLSL sources of a directory as C++ string literals.
#
#   spux_embed_shaders(<out_var> <shader_dir> <output_file>)
#
# Writes <output_file> (a .cpp) with kShaderSources[] = {{name, text}, ...} in spux::ui::modern and sets
# <out_var> to its path. Runs at configure time; the shader files are configure dependencies, so editing
# one re-runs CMake. The file is only rewritten when its content changes. Long sources are split into
# pieces because MSVC limits the length of a string literal.
function(spux_embed_shaders out_var shader_dir output_file)
  file(GLOB shaders CONFIGURE_DEPENDS "${shader_dir}/*.glsl" "${shader_dir}/*.vert" "${shader_dir}/*.frag")
  set(content "// Generated by cmake/SpuxEmbedShaders.cmake from src/ui/modern/shaders. Do not edit.\n#include \"ShaderSources.hpp\"\n\nnamespace spux::inline v1::ui::modern {\n\nconst ShaderSource kShaderSources[] = {\n")
  set(count 0)
  foreach(path ${shaders})
    get_filename_component(name "${path}" NAME)
    file(READ "${path}" text)
    string(LENGTH "${text}" len)
    set(pieces "")
    set(pos 0)
    while(pos LESS len)
      math(EXPR remaining "${len} - ${pos}")
      if(remaining GREATER 6000)
        set(take 6000)
      else()
        set(take ${remaining})
      endif()
      string(SUBSTRING "${text}" ${pos} ${take} piece)
      string(APPEND pieces "R\"SPX(${piece})SPX\"\n")
      math(EXPR pos "${pos} + ${take}")
    endwhile()
    string(APPEND content "    {\"${name}\",\n${pieces}    },\n")
    math(EXPR count "${count} + 1")
  endforeach()
  string(APPEND content "};\nconst unsigned long kShaderSourceCount = ${count};\n\n} // namespace spux::inline v1::ui::modern\n")
  get_filename_component(out_dir "${output_file}" DIRECTORY)
  file(MAKE_DIRECTORY "${out_dir}")
  file(WRITE "${output_file}.tmp" "${content}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${output_file}.tmp" "${output_file}")
  set(${out_var} "${output_file}" PARENT_SCOPE)
endfunction()
